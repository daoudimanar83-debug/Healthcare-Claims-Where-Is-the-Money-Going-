      <aliases enabled='yes' />
      <column caption='paid_ratio' datatype='real' name='[Calculation_0074823874420736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [billed_amount] = 0 THEN NULL&#13;&#10;ELSE [paid_amount] / [billed_amount] * 100&#13;&#10;END' />
      </column>
      <column caption='card' datatype='real' name='[Calculation_0074823904849921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([paid_amount]) / SUM([billed_amount])' />
      </column>
      <column caption='average_paid_per_claim' datatype='real' name='[Calculation_0771089278242816]' role='measure' type='quantitative'>
